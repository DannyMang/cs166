{
  "manifest_version": 3,
  "name": "Phishing Shield",
  "version": "1.0",
  "description": "Detects and prevents phishing attempts using machine learning",
  "permissions": ["activeTab", "storage", "webNavigation"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/dave.jpg",
      "48": "icons/dave.jpg",
      "128": "icons/dave.jpg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/dave.jpg",
    "48": "icons/dave.jpg",
    "128": "icons/dave.jpg"
  }
} 